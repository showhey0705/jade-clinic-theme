		"custom": {
			"fontWeight": {
				"black": 900,
				"bold": 700,
				"extra-bold": 800,
				"extra-light": 200,
				"light": 300,
				"medium": 500,
				"regular": 420,
				"semi-bold": 600,
				"thin": 100
			},
			"line-green": "#06C755",
			"line-green-fg": "#FFFFFF",
			"lineHeight": {
				"body": 1.5,
				"loose": 2,
				"none": 1,
				"overlap": 0.88,
				"relaxed": 1.725,
				"snug": 1.2,
				"tight": 1.1
			},
			"sale": "#E11D48",
			"sale-fg": "#FFFFFF"
		},
		"layout": {
			"contentSize": "640px",
			"wideSize": "1280px"
		},
