	"styles": {
		"blocks": {
			"core/code": {
				"border": {
					"radius": "8px",
					"width": "0px"
				},
				"color": {
					"background": "var(--wp--preset--color--tertiary)",
					"text": "var(--wp--preset--color--main)"
				},
				"spacing": {
					"padding": {
						"bottom": "var(--wp--preset--spacing--medium)",
						"left": "var(--wp--preset--spacing--medium)",
						"right": "var(--wp--preset--spacing--medium)",
						"top": "var(--wp--preset--spacing--medium)"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--monospace)",
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/comment-author-name": {
				"elements": {
					"link": {
						"typography": {
							"fontSize": "var(--wp--preset--font-size--base)",
							"textDecoration": "none"
						}
					}
				},
				"typography": {
					"fontWeight": "600",
					"lineHeight": "var(--wp--custom--line-height--body)"
				}
			},
			"core/comment-content": {
				"spacing": {
					"margin": {
						"top": "20px !important"
					}
				}
			},
			"core/comment-date": {
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						}
					}
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"lineHeight": "var(--wp--custom--line-height--body)"
				}
			},
			"core/comment-edit-link": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"lineHeight": "var(--wp--custom--line-height--body)"
				}
			},
			"core/comment-reply-link": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/comments-title": {
				"spacing": {
					"margin": {
						"bottom": "var(--wp--preset--spacing--large)",
						"top": "0px"
					}
				}
			},
			"core/details": {
				"css": ".wp-block-details summary { font-weight: 600 }"
			},
			"core/image": {
				"border": {
					"radius": "13px"
				},
				"spacing": {
					"margin": {
						"bottom": "var(--wp--preset--spacing--large)",
						"left": "auto",
						"right": "auto",
						"top": "var(--wp--preset--spacing--medium)"
					}
				}
			},
			"core/list-item": {
				"spacing": {
					"margin": {
						"bottom": "var(--vip2026-list-gap, 0.3em)"
					}
				}
			},
			"core/navigation": {
				"elements": {
					"link": {
						":hover": {
							"typography": {
								"textDecoration": "underline"
							}
						}
					}
				},
				"typography": {
					"fontWeight": "500"
				}
			},
			"core/paragraph": {
				"css": "&.has-background { padding: var(--wp--preset--spacing--small) }"
			},
			"core/post-comments-form": {
				"elements": {
					"heading": {
						"typography": {
							"fontSize": "var(--wp--preset--font-size--medium)"
						}
					}
				}
			},
			"core/post-template": {
				"elements": {
					"h2": {
						"typography": {
							"fontSize": "var(--wp--preset--font-size--medium)"
						}
					}
				}
			},
			"core/post-terms": {
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/post-title": {
				"elements": {
					"link": {
						":hover": {
							"typography": {
								"textDecoration": "underline"
							}
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/preformatted": {
				"border": {
					"radius": "13px"
				},
				"color": {
					"background": "var(--wp--preset--color--tertiary)",
					"text": "var(--wp--preset--color--main)"
				},
				"spacing": {
					"padding": {
						"bottom": "var(--wp--preset--spacing--medium)",
						"left": "var(--wp--preset--spacing--medium)",
						"right": "var(--wp--preset--spacing--medium)",
						"top": "var(--wp--preset--spacing--medium)"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--monospace)",
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/pullquote": {
				"border": {
					"color": "var(--wp--preset--color--primary)",
					"top": {
						"style": "solid",
						"width": "2px"
					}
				},
				"elements": {
					"cite": {
						"color": {
							"text": "var(--wp--preset--color--secondary)"
						},
						"typography": {
							"fontSize": "var(--wp--preset--font-size--small)"
						}
					}
				},
				"spacing": {
					"blockGap": "var(--wp--preset--spacing--medium)",
					"padding": {
						"bottom": "0",
						"left": "var(--wp--preset--spacing--medium)",
						"right": "var(--wp--preset--spacing--medium)",
						"top": "0"
					}
