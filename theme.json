			"palette": [
				{
					"color": "#8F6F52",
					"name": "Brand",
					"slug": "primary"
				},
				{
					"color": "#E3DBD4",
					"name": "Brand Accent",
					"slug": "primary-accent"
				},
				{
					"color": "#B59D88",
					"name": "Brand Alt",
					"slug": "primary-alt"
				},
				{
					"color": "#392B1E",
					"name": "Brand Alt Accent",
					"slug": "primary-alt-accent"
				},
				{
					"color": "#1F1A15",
					"name": "Contrast",
					"slug": "main"
				},
				{
					"color": "#D0C7BF",
					"name": "Contrast Accent",
					"slug": "main-accent"
				},
				{
					"color": "#FFFFFF",
					"name": "Base",
					"slug": "base"
				},
				{
					"color": "#664E38",
					"name": "Base Accent",
					"slug": "secondary"
				},
				{
					"color": "#EBE6E1",
					"name": "Tint",
					"slug": "tertiary"
				},
				{
					"color": "#DBD1C8",
					"name": "Border Base",
					"slug": "border-light"
				},
				{
					"color": "#7D634B",
					"name": "Border Contrast",
					"slug": "border-dark"
				}
			]
