{
	"$schema": "https://schemas.wp.org/wp/7.0/theme.json",
	"version": 3,
	"customTemplates": [
		{
			"name": "page-no-title",
			"postTypes": [
				"page",
				"post"
			],
			"title": "Page (Full Width, No Title)"
		},
		{
			"name": "page-with-sidebar",
			"postTypes": [
				"post",
				"page"
			],
			"title": "Page (With Sidebar)"
		}
	],
	"settings": {
		"appearanceTools": true,
		"color": {
			"gradients": [
				{
					"gradient": "linear-gradient(135deg in oklch, #e8e8ff 10%, #ffddab 37%, #fcbbbf 69%, #bdebe8 75%, #ffefcd 85%)",
					"name": "Rainbow",
					"slug": "rainbow"
				},
				{
					"gradient": "radial-gradient(farthest-side at 73% 21%, transparent, #1a1d29)",
					"name": "Radial",
					"slug": "radial"
				},
				{
					"gradient": "linear-gradient(0deg, var(--wp--preset--color--tertiary), var(--wp--preset--color--base))",
					"name": "Background Subtle",
					"slug": "bg-subtle"
				},
				{
					"gradient": "linear-gradient(180deg, var(--wp--preset--color--tertiary), var(--wp--preset--color--base))",
					"name": "Background Subtle 2",
					"slug": "bg-subtle-2"
				},
				{
					"gradient": "linear-gradient(135deg in oklch, var(--wp--preset--color--main), var(--wp--preset--color--border-dark))",
					"name": "Background Dark",
					"slug": "bg-dark"
				},
				{
					"gradient": "linear-gradient(135deg in oklch, var(--wp--preset--color--primary-alt), var(--wp--preset--color--main-accent))",
					"name": "Background Light",
					"slug": "bg-light"
				},
				{
					"gradient": "linear-gradient(345deg in oklch, var(--wp--preset--color--primary) 50%, rgba(255,255,255,0) 50%)",
					"name": "Background Brand",
