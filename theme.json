					"name": "Light Section Fade",
					"slug": "light-section-fade"
				},
				{
					"gradient": "linear-gradient(135deg in oklch, oklch(0.4138 0.0584 146.02) 0%, oklch(0.2902 0.0291 139.02) 100%)",
					"name": "Jade Green",
					"slug": "jade-green"
