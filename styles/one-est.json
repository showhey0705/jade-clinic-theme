{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "One Est",
	"settings": {
		"color": {
			"palette": [
				{
					"name": "Brand",
					"slug": "primary",
					"color": "#C08B80"
				},
				{
					"name": "Brand Accent",
					"slug": "primary-accent",
					"color": "#F3E6E2"
				},
				{
					"name": "Brand Alt",
					"slug": "primary-alt",
					"color": "#A96F62"
				},
				{
					"name": "Brand Alt Accent",
					"slug": "primary-alt-accent",
					"color": "#3E2A25"
				},
				{
					"name": "Contrast",
					"slug": "main",
					"color": "#221B18"
				},
				{
					"name": "Contrast Accent",
					"slug": "main-accent",
					"color": "#E3D0CA"
				},
				{
					"name": "Base",
					"slug": "base",
					"color": "#FFFFFF"
				},
				{
					"name": "Base Accent",
					"slug": "secondary",
					"color": "#7A5F57"
				},
				{
					"name": "Tint",
					"slug": "tertiary",
					"color": "#F6EFEC"
				},
				{
					"name": "Border Base",
					"slug": "border-light",
					"color": "#E6D8D3"
				},
				{
					"name": "Border Contrast",
					"slug": "border-dark",
					"color": "#8F6B61"
				}
			]
		},
		"typography": {
			"fluid": true
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|main"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|jp-sans",
			"fontSize": "var:preset|font-size|base",
			"fontWeight": "430",
			"letterSpacing": "0.03em",
			"lineHeight": "var:custom|lineHeight|loose"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|jp-serif",
					"fontWeight": "300",
					"letterSpacing": "0.02em",
					"lineHeight": "var:custom|lineHeight|snug"
				}
			},
			"link": {
				"color": {
					"text": "var:preset|color|primary"
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|primary",
					"text": "var:preset|color|base"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|jp-sans",
					"fontWeight": "var:custom|fontWeight|regular",
					"letterSpacing": "0.08em"
				}
			}
		}
	}
}
